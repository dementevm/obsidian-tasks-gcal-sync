{
  "name": "tasks-gcal-sync",
  "version": "0.2.7",
  "description": "Privacy-first one-way sync from Obsidian Tasks to Google Calendar",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "google-calendar",
    "tasks"
  ],
  "author": "Mikhail Dementev",
  "license": "GPL-3.0",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "16.11.6",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "just-debounce-it": "^3.2.0",
    "tslib": "2.8.1",
    "zustand": "^5.0.3"
  },
  "contributors": [
    "Sasoon Sarkisian (original upstream author)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dementevm/obsidian-tasks-gcal-sync.git"
  },
  "homepage": "https://github.com/dementevm/obsidian-tasks-gcal-sync#readme"
}
